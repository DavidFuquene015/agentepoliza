DB_NAME=colvacontratos

# ── APIs de Inteligencia Artificial ──────────────────────────
# Las claves (GEMINI_API_KEY / OPENAI_API_KEY / NVIDIA_API_KEY) YA NO van aquí:
# viven CIFRADAS en la tabla `api_keys` de MySQL (ver sql/000_esquema_completo.sql).
# La app las lee al arrancar con database.get_api_key(). Para rotar una clave:
#   python -c "import database; database.guardar_api_key('GEMINI_API_KEY', 'nueva-clave')"
# Si defines una aquí, solo se usa como RESPALDO cuando la BD no la tiene.

OPENAI_MODEL=gpt-5.5
OPENAI_MAX_OUTPUT_TOKENS=4096

DOCUMENT_STORAGE_ROOT=var/documentos_hist

# ── Modelos NVIDIA NIM (DeepSeek / Qwen / MiniMax / GLM) ─────
DEEPSEEK_MODEL=deepseek-ai/deepseek-v4-pro
QWEN_MODEL=qwen/qwen3.5-397b-a17b
MINIMAX_MODEL=minimaxai/minimax-m3
GLM_MODEL=z-ai/glm-5.1
DEEPSEEK_MAX_OUTPUT_TOKENS=4096
GLM_MAX_OUTPUT_TOKENS=4096

INTERNAL_API_KEY=colva-agente-2026

# Tope de texto enviado a la IA (evita 429 de Gemini y 504 de NVIDIA)
MAX_CHARS_PROMPT_CONTRATO=60000
MAX_CHARS_PROMPT_POLIZAS=25000

# ── Análisis por VISIÓN (lee pólizas escaneadas) ──────────────
# Motores autorizados a enviar las páginas como imagen. Solo funciona con
# proveedores de tipo openai_compatible. Vacío = ningún motor usa visión.
MOTORES_VISION=openai,sol-2
# Resolución del render: 2.2 ≈ 158 ppp. Subir si el escaneo es de mala calidad.
VISION_ESCALA=2.2
# Tope de páginas por documento enviadas como imagen.
VISION_MAX_PAGINAS=40
# Calidad JPEG del render (90 es indistinguible tras el reescalado del proveedor).
VISION_CALIDAD_JPEG=90
# 0 = solo se envían como imagen las páginas escaneadas (recomendado).
# 1 = se envían TODAS las páginas como imagen (máxima potencia, más peso).
VISION_TODAS_LAS_PAGINAS=0
# Piso de tokens de SALIDA en análisis por visión. Los modelos de razonamiento
# (gpt-5.x) gastan parte de este cupo pensando antes de escribir; con 4.096 se
# quedaban sin espacio y devolvían una respuesta vacía.
VISION_MIN_TOKENS_SALIDA=32000
# 1 = si un motor no está en MOTORES_VISION, se deduce del model_id
# (gpt-5, gpt-4o, gemini, claude...). Evita que un motor nuevo del panel
# caiga en solo-texto por olvido. 0 = solo la lista explícita.
VISION_AUTO=1
